# ─── Anthropic ────────────────────────────────────────────────────────────────
# Required — get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ─── Sarvam AI (Indian-language coaching: translate, voice input/output) ──────
# Optional — without it, the coach works in English only (language picker and
# mic/listen buttons are hidden). Get a key from https://dashboard.sarvam.ai
SARVAM_API_KEY=your-sarvam-api-key-here

# ─── Ephemeris service ────────────────────────────────────────────────────────
# URL of the Python ephemeris microservice
# Local dev: http://localhost:8000
# Production: set to your Railway/Render deployment URL
EPHEMERIS_SERVICE_URL=http://localhost:8000

# CORS origins allowed by the Python service — set this in Railway → Variables.
# Comma-separated list. Restrict to your Vercel domain in production.
# Example: https://your-app.vercel.app
# Omit (or leave as default) in local dev; the service defaults to localhost.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Shared secret required by the Python service on /calculate, /dasha, /transits.
# Set the SAME value here and as EPHEMERIS_SHARED_SECRET in the Python service's
# environment (Railway → Variables). Without this, anyone who learns the
# deployed ephemeris URL can call it directly, bypassing this app's rate limiter.
# Generate with: openssl rand -base64 32
# Required in production. Safe to leave unset for local dev only.
EPHEMERIS_SHARED_SECRET=your-shared-secret-here

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Required — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-random-secret-here

# Required — base URL of your app (no trailing slash)
# Local dev: http://localhost:3000
# Production: https://your-app.vercel.app
NEXTAUTH_URL=http://localhost:3000

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Required for authentication and data persistence
# Get from: https://app.supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Required for cloud sync (server-only — never expose to the browser).
# All Supabase writes/reads for user data go through server API routes using
# this key, scoped to the verified NextAuth session user id. Get from the same
# Settings → API page as above ("service_role" key).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Optional distributed rate limiting (recommended for Vercel) ─────────────
# Add these to enforce per-user limits across all serverless instances.
# Create a Redis database at https://upstash.com and copy the REST credentials.
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ─── Phone OTP (via Supabase) ─────────────────────────────────────────────────
# Enable phone auth in Supabase Dashboard:
#   Authentication → Providers → Phone → Enable
#   Then configure an SMS provider (Twilio recommended):
#     Authentication → Providers → Phone → Twilio
#   Required Twilio settings (set in Supabase Dashboard, NOT here):
#     - Account SID
#     - Auth Token
#     - Message Service SID (or From number)
# No extra env vars needed here — Supabase manages the SMS provider config.
