# Copy to `.env` (never commit `.env`). Used by docker compose and one-host Docker.
# Generate secrets: openssl rand -base64 32

# Required between Next and Python even on the Docker network.
EPHEMERIS_SHARED_SECRET=

# Next.js public URL (no trailing slash)
# Railway: https://<app>.up.railway.app (or your custom domain). No trailing slash.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Compose wires this internally to http://ephemeris:8000.
# One-container Dockerfile / Railway-only: http://127.0.0.1:8000 (same container).
# Do not point this at a second Railway service or at Vercel.
EPHEMERIS_SERVICE_URL=http://127.0.0.1:8000

# Python CORS — public origin of the Next app
ALLOWED_ORIGINS=http://localhost:3000

# Optional: keep Supabase (not Railway/Vercel)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

ANTHROPIC_API_KEY=
SARVAM_API_KEY=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

CRON_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com
