{
  "name": "Astro Coach",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "user": "ubuntu",
  "install": ".cursor/install.sh",
  "start": ".cursor/start.sh",
  "terminals": [
    {
      "name": "ephemeris-api",
      "command": "cd python-service && .venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000"
    },
    {
      "name": "nextjs-dev",
      "command": "cd astro-coach && npm run dev -- --hostname 0.0.0.0"
    }
  ],
  "ports": [
    { "port": 3000 },
    { "port": 8000 }
  ]
}
